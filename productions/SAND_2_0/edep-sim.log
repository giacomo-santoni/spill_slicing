% %%%% Set Run Conditions
% %%     Condition Name: edepsim-defaults
% %%     Version:        1.0
##############################################
# Define the default GEANT parameter settings
##############################################
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
##############################################
# Set the thresholds for saving trajectories into the output file.  All
# primary particle trajectories are saved so these only apply to secondary
# particles.  Energy that is deposited by unsaved secondaries is "assigned"
# to the "nearest" parent particle.
##############################################
/edep/db/set/saveAllPrimTraj true
/edep/db/set/lengthThreshold 1 mm
/edep/db/set/trajectoryAccuracy 1 mm
/edep/db/set/neutronThreshold 50 MeV
/edep/db/set/gammaThreshold 10 MeV
##############################################
# Set any physics limits.
##############################################
# Set the default ionization model.  The choices are 0) NEST which is slow,
# general, and accurate, 1) DokeBirks which is about 200 times faster
# than NEST, but only applicable to LAr (code stolen from NEST).
/edep/phys/ionizationModel 1
/edep/db/open /storage/gpfs_data/neutrino/users/gsantoni/productions/SAND_2/SAND_2_0/sand-events.0.edep.root
% EDepSim::RootPersistencyManager::Open /storage/gpfs_data/neutrino/users/gsantoni/productions/SAND_2/SAND_2_0/sand-events.0.edep.root
/control/execute /storage/gpfs_data/neutrino/users/gsantoni/productions/SAND_2/SAND_2_0/macro.mac
################################
# Add the GENIE events
################################
## Replace this with the name of a GENIE rooTracker file
/generator/kinematics/rooTracker/input /storage/gpfs_data/neutrino/users/gsantoni/productions/SAND_2/SAND_2_0/sand-events.0.gtrac.root
## Use the T2K rooTracker input format.  This is directly supported by GENIE.
/generator/kinematics/set rooTracker
%   Kinematics factory set to: rooTracker
## Distribute the events based on the vertex in the rooTracker file.
/generator/position/set free
%   Position factory set to: free
## The overlay file will have markers at the end of each event.  This tells
## edep-sim to generate vertices until it runs into an end-of-event marker.
## The value doesn't matter, but it needs to be larger than the maximum number
## of vertices in an event.
#/generator/count/fixed/number 10000
#/generator/count/set fixed
## Distribute the event times based onn the time in the rooTracker file.
/generator/time/set free
%   Time factory set to: free
#/generator/time/spill/start 0.0 ns
#/generator/time/spill/bunchCount 1000
#/generator/time/spill/bunchSep 10.0 ns
#/generator/time/spill/bunchLength 5.0 ns
## Make sure EDEPSIM updates the kinematics generator.
/generator/add
